# Optional Hugging Face Hub access token for gated models or higher API rate limits
HF_TOKEN=

# Set to true to let the ML worker download the first uncached multi-GB checkpoint on demand.
# Checkpoints already present in the Hugging Face cache are used regardless of this flag.
# (When false, uncached models are skipped and the worker reports the skip reason in backend_used)
HF_EAGER_DOWNLOAD=false

# Docker only: host Hugging Face cache to mount into the ML worker. Point this at ~/.cache/huggingface
# to reuse checkpoints you already downloaded (scripts/run.sh sets it automatically when it exists).
# Leave it unset to use the 'hf_cache' named volume instead.
# HF_CACHE_DIR=/home/you/.cache/huggingface

# Service ports (must match the URLs the gateway talks to)
GO_PORT=18080
RUST_PORT=18081
ML_PORT=18082

# How the Go gateway reaches the other services
RUST_ENGINE_URL=http://localhost:18081
ML_WORKER_URL=http://localhost:18082

# Gallery storage directory
DATA_DIR=./data

# --- Gateway security (all optional) ---------------------------------------
# Shared bearer token. When set, /api/* (except /api/health) requires
# "Authorization: Bearer <token>". The bundled UI reads VITE_API_TOKEN at build
# time, so set both if you serve the studio yourself.
SVGML_API_TOKEN=

# Comma-separated list of allowed browser origins. Empty means same-origin only
# (the nginx proxy and the single binary need no CORS). Use * to allow any origin.
CORS_ALLOWED_ORIGINS=

# Per-IP requests/minute for generation, download and search routes. Health and
# model status polling are never limited. Set to 0 to disable.
RATE_LIMIT_PER_MIN=60

# Set to 1 when running the packaged single binary (serves the UI on 5173 and
# launches the embedded Rust engine / ML worker as child processes)
# SINGLE_BINARY=1
