# Optional Hugging Face Hub access token for gated models or higher API rate limits
HF_TOKEN=

# Set to true to eagerly download and execute multi-GB Hugging Face weights in PyTorch
# (When false, uses fast PyTorch/LiteRT tensor & semantic SVG synthesis suitable for instant CPU usage)
HF_EAGER_DOWNLOAD=false

# Service ports
GO_PORT=8080
RUST_PORT=8081
ML_PORT=8082
